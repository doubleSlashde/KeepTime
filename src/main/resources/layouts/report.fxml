<?import javafx.geometry.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="reportRoot" focusTraversable="true" prefWidth="500.0" style="-fx-background-color: white;" stylesheets="@../css/dsStyles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.doubleslash.keeptime.view.ReportController">
   <children>
      <VBox>
         <children>
            <BorderPane fx:id="topBorderPane" prefWidth="480.0">
               <left>
                  <VBox fillWidth="false" prefHeight="185.0" prefWidth="213.0" BorderPane.alignment="CENTER">
                     <children>
                        <Label text="Report">
                           <font>
                              <Font name="Open Sans Bold" size="35.0" />
                           </font>
                        </Label>
                        <Label layoutX="10.0" layoutY="10.0" text="Daily report">
                           <font>
                              <Font name="Open Sans Regular" size="20.0" />
                           </font>
                        </Label>
                        <Label fx:id="currentDayLabel" text="Tuesday 05.07.2018">
                           <font>
                              <Font name="Open Sans Bold" size="17.0" />
                           </font>
                        </Label>
                        <HBox spacing="10.0">
                           <children>
                              <Label prefWidth="110.0" text="Present time:">
                                 <font>
                                    <Font name="Open Sans Regular" size="17.0" />
                                 </font>
                              </Label>
                              <Label fx:id="currentDayTimeLabel" text="99:99:99">
                                 <font>
                                    <Font name="Open Sans Regular" size="17.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Label prefWidth="110.0" text="Work time:">
                                 <font>
                                    <Font name="Open Sans Regular" size="17.0" />
                                 </font>
                              </Label>
                              <Label fx:id="currentDayWorkTimeLabel" text="99:99:99">
                                 <font>
                                    <Font name="Open Sans Regular" size="17.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </left>
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </BorderPane>
            <BorderPane>
               <left>
                   <HBox spacing="5.0">
                       <children>
                           <Button fx:id="expandCollapseButton" mnemonicParsing="false" prefHeight="25.0" prefWidth="80.0" styleClass="secondary-button" text="Collapse" />
                           <Button fx:id="addWorkButton" mnemonicParsing="false" prefHeight="25.0" prefWidth="80.0" styleClass="secondary-button" text="Add Work" />
                    </children>
                   </HBox>
               </left>
               <right>
                        <Button fx:id="heimatSyncButton" mnemonicParsing="false" styleClass="secondary-button" text="Sync2Heimat" />
               </right>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </BorderPane>
            <Canvas fx:id="colorTimeLineCanvas" height="7.0" width="499.0" />
            <TreeTableView fx:id="workTableTreeView" prefHeight="300.0" prefWidth="500.0" showRoot="false" />
         </children>
      </VBox>
   </children>
</AnchorPane>
